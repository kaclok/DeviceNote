<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- mapper namespace作用是：代码和xml进行关联 -->
<!-- https://blog.csdn.net/xu962336414/article/details/105624371 -->
<mapper namespace="com.smlj.singledevice_note.logic.o.vo.table.dao.TRoleDao">

    <!-- perms 是 PG varchar[]，必须走 ArrayTypeHandler，不能用 resultType 自动映射 -->
    <resultMap id="RoleResultMap" type="com.smlj.singledevice_note.logic.o.vo.table.entity.TRole">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="data_scope" column="data_scope"/>
        <result property="is_using" column="is_using"/>
        <result property="perms" column="perms" typeHandler="org.apache.ibatis.type.ArrayTypeHandler"/>
    </resultMap>

    <select id="queryById" resultMap="RoleResultMap">
        select * from dept_user.t_role
        where id = #{id}
    </select>

    <!-- 只返回启用角色：停用角色不参与「有效档位」计算，调用方按查不到处理 -->
    <select id="queryByIds" resultMap="RoleResultMap">
        select * from dept_user.t_role
        where is_using = true
        <if test="ids != null and ids.size() > 0">
            and id IN
            <foreach collection="ids" item="oneId" open="(" separator="," close=")">
                #{oneId}
            </foreach>
        </if>
    </select>
</mapper>
