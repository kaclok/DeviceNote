<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- mapper namespace作用是：代码和xml进行关联 -->
<!-- https://blog.csdn.net/xu962336414/article/details/105624371 -->
<mapper namespace="com.smlj.singledevice_note.logic.o.vo.table.dao.TCGHTUserDao">
    <select id="queryAll" resultType="com.smlj.singledevice_note.logic.o.vo.table.entity.TCGHTUser">
        select * from cght.t_user
        where open_status = true
        <if test="includeAdmin == false">
            and role_code != 'ADMIN'
        </if>
    </select>

    <select id="query" resultType="com.smlj.singledevice_note.logic.o.vo.table.entity.TCGHTUser">
        select * from cght.t_user
        where account = #{account}
    </select>

    <select id="exist" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM cght.t_user WHERE account = #{account}
    </select>
</mapper>
