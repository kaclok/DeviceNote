<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smlj.singledevice_note.logic.o.vo.table.dao.TCGHTUserDao">

    <!-- 查询账号：支持关键字(account/username 模糊) + 归属部门精确筛选，分页由调用方 PageHelper 控制 -->
    <select id="queryAll" resultType="com.smlj.singledevice_note.logic.o.vo.table.entity.TCGHTUser">
        select
            account,
            username,
            pwd,
            role_code,
            dept_code,
            open_status,
            data_scope
        from cght.t_user
       <where>
           <if test="kw != null and kw != ''">
               and (account like concat('%', #{kw}, '%') or username like concat('%', #{kw}, '%'))
           </if>
           <if test="filterOpenStatus == true">
               and open_status = true
           </if>
           <if test="includeAdmin == false">
               and role_code != 'ADMIN'
           </if>
           <!-- 最终可见部门集下推（与合同列表同一口径）：由 CCGHT.deptFilterOf 合并后传入 ——
                它已把「筛选部门（含其整棵子树）」与「数据范围白名单」求过交，这里只做单一 in。
                deptCodes == null   -> 不加条件（未筛部门 且 全集团）
                deptCodes 为空列表  -> and 1 = 0（fail-closed；不能生成 in ()，PG 语法错误） -->
           <if test="deptCodes != null">
               <choose>
                   <when test="deptCodes.size() &gt; 0">
                       and dept_code in
                       <foreach collection="deptCodes" item="sd" open="(" separator="," close=")">#{sd}</foreach>
                   </when>
                   <otherwise>and 1 = 0</otherwise>
               </choose>
           </if>
           <!-- 「本人」档（data_scope=1）：账号列表同样只放行自己 —— 与合同列表的 creator 条件对称。
                缺少它时 1 档账号会看到同部门全部同事，而账号列表正是所有账号写入接口的入口，
                看得见就能重置密码 / 改角色（同事若是 EDITOR，重置后登录即拿到更大的范围）。
                scopeOwner 为空表示该档位不叠加此条件（2/3/4 档）。 -->
           <if test="scopeOwner != null and scopeOwner != ''">
               and account = #{scopeOwner}
           </if>
       </where>

        order by account asc
    </select>

    <select id="query" resultType="com.smlj.singledevice_note.logic.o.vo.table.entity.TCGHTUser">
        select
            account,
            username,
            pwd,
            role_code,
            dept_code,
            open_status,
            data_scope
        from cght.t_user
        where account = #{account}
    </select>

    <select id="exist" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM cght.t_user WHERE account = #{account}
    </select>

    <!-- 新增账号：account/username/pwd/role_code/dept_code 为核心必填；data_scope 由随后的 updateScope 写入 -->
    <insert id="insert" parameterType="com.smlj.singledevice_note.logic.o.vo.table.entity.TCGHTUser">
        insert into cght.t_user (
            account, username, pwd, role_code, dept_code, open_status
        ) values (
            #{u.account},
            #{u.username},
            #{u.pwd},
            #{u.role_code},
            #{u.dept_code},
            #{u.open_status}
        )
    </insert>

    <!-- 更新账号：username / role_code / dept_code -->
    <update id="update" parameterType="com.smlj.singledevice_note.logic.o.vo.table.entity.TCGHTUser">
        update cght.t_user
        <set>
            username = #{u.username},
            role_code = #{u.role_code},
            dept_code = #{u.dept_code},
        </set>
        where account = #{u.account}
    </update>

    <!-- 设置数据范围（整体赋值）：data_scope 必传（列 NOT NULL） -->
    <update id="updateScope">
        update cght.t_user
        set data_scope = #{data_scope}
        where account = #{account}
    </update>

    <update id="resetPwd">
        update cght.t_user set pwd = #{pwd} where account = #{account}
    </update>

    <update id="toggleStatus">
        update cght.t_user set open_status = #{open_status} where account = #{account}
    </update>
</mapper>
