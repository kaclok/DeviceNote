<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smlj.singledevice_note.logic.o.vo.table.dao.TCGHTContractDao">

    <!-- 导入链路同样按模版路由（见下）：CCGHT 核对 t_contract_template.tb_name 后调用 insertRow，
         本文件不再有写死 cght.t_contract 的语句。 -->

    <!-- ==================================================================
         按物理表路由的台账读写与导入
         ⚠️ ${tb} 与 ${p.col} / ${c.col} 是拼接进 SQL 的**标识符**：
            · tb  已由 CCGHT 用 t_contract_template 登记过的 tb_name 核对，并传回登记时的规范表名；
            · col 已由 CCGHT 用 ^[a-z_][a-z0-9_]{0,62}$ 核对，且确认存在于该表、不在只读黑名单。
         值一律 #{...} 预编译绑定，从不参与拼接。
         不同物理表列不同，所以结果统一用 LinkedHashMap 承载（select *）。
         ================================================================== -->

    <!-- 物理表列清单（PG 元数据，只读）：表名是 #{} 绑定的值，不拼接 -->
    <select id="columnMeta" resultType="java.util.LinkedHashMap">
        select column_name as name, data_type as type
        from information_schema.columns
        where table_schema = 'cght'
          and table_name = #{tb}
        order by ordinal_position
    </select>

    <select id="queryRows" resultType="java.util.LinkedHashMap">
        select * from cght.${tb}
        where open_status = true
        <!-- 通用筛选：op 已由 Java 侧限定为 like|eq|gte|lte|ne -->
        <foreach collection="conds" item="c">
            <choose>
                <when test="c.op == 'like'">
                    and ${c.col} like concat('%', #{c.v}, '%')
                </when>
                <when test="c.op == 'gte'">
                    and ${c.col} &gt;= #{c.v}
                </when>
                <when test="c.op == 'lte'">
                    and ${c.col} &lt;= #{c.v}
                </when>
                <when test="c.op == 'ne'">
                    and ${c.col} &lt;&gt; #{c.v}
                </when>
                <otherwise>
                    and ${c.col} = #{c.v}
                </otherwise>
            </choose>
        </foreach>
        <!-- 最终可见部门集下推：null = 不限制；非空 = in 这些部门；
             空列表 = 交集为空（选中部门超出可见范围 / 账号无任何可见部门），用 1=0 兜底
             （不能生成 in () —— PG 语法错误）。 -->
        <if test="deptCodes != null">
            <choose>
                <when test="deptCodes.size() > 0">
                    and dept_code in
                    <foreach collection="deptCodes" item="sd" open="(" separator="," close=")">#{sd}</foreach>
                </when>
                <otherwise>
                    and open_status = false
                </otherwise>
            </choose>
        </if>
        <!-- 「本人」档（data_scope=1）：只放行「我签的」合同 —— sign_person = 我的姓名。
             已登记的两张表都有 sign_person；匹配方式与 CCGHT 的范围判定严格同口径，
             否则会出现「列表查不到、直连 unique_id 却能读/改/删」的单条越权。 -->
        <if test="user_name != null and user_name != ''">
            and sign_person = #{user_name}
        </if>
        <!-- 预警筛选：预警天数 &lt; warn_day。算法与旧 queryAll 一致
             （date_rk + paycycle*30 天 - 今天）。只有含 date_rk/paycycle_dh/paycycle_zb
             的表才允许传非空 warn_day（Java 侧拦），否则这里引用的列不存在。 -->
        <if test="warn_day != null">
            AND (
                (finish_step = 1
                AND date_rk IS NOT NULL
                AND #{warn_day} > EXTRACT(DAY FROM (date_rk + (paycycle_dh * 30) * INTERVAL '1 day') - CURRENT_DATE))
                OR
                (finish_step = 2
                AND date_rk IS NOT NULL
                AND #{warn_day} > EXTRACT(DAY FROM (date_rk + (paycycle_zb * 30) * INTERVAL '1 day') - CURRENT_DATE))
            )
        </if>

        order by id asc
    </select>

    <select id="queryRow" resultType="java.util.LinkedHashMap">
        select * from cght.${tb}
        where unique_id = #{unique_id}
    </select>

    <select id="existId" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM cght.${tb} WHERE id = #{id} and open_status = true
    </select>

    <insert id="insertRow">
        insert into cght.${tb} (
        <foreach collection="pairs" item="p" separator=",">${p.col}</foreach>
        ) values (
        <foreach collection="pairs" item="p" separator=",">#{p.val}</foreach>
        )
    </insert>

    <update id="updateRow">
        update cght.${tb}
        set
        <foreach collection="pairs" item="p" separator=",">${p.col} = #{p.val}</foreach>
        where unique_id = #{unique_id}
    </update>

    <update id="markInvalidRow">
        update cght.${tb} set open_status = false where unique_id = #{unique_id}
    </update>
</mapper>
