<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- mapper namespace作用是：代码和xml进行关联 -->
<mapper namespace="com.smlj.singledevice_note.logic.o.vo.table.dao.TCGHTContractTemplateDao">
    <!-- 模版全量：台账/导入页的「合同模版」下拉数据源（按 id 升序，下拉顺序稳定） -->
    <select id="queryAll" resultType="com.smlj.singledevice_note.logic.o.vo.table.entity.TCGHTContractTemplate">
        select id, name, tb_name, col_order
        from cght.t_contract_template
        order by id asc
    </select>

    <select id="query" resultType="com.smlj.singledevice_note.logic.o.vo.table.entity.TCGHTContractTemplate">
        select id, name, tb_name, col_order
        from cght.t_contract_template
        where id = #{id}
    </select>

    <!-- 写入部门绑定前校验模版存在：让"模版不存在"返回可读提示，而不是把 FK 违例抛成 500 -->
    <select id="exist" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM cght.t_contract_template WHERE id = #{id}
    </select>

    <!--
      保存 Excel 列顺序（模板表头预览里拖拽后的结果）。
      col_order = null 即"清除覆盖、回到 gd.json 的登记顺序"，所以不用区分空串与 null。
      字段名已在 CCGHT 里对着该模版指向的物理表逐个核对过，这里不做二次校验（值走 #{} 绑定）。
    -->
    <update id="updateColOrder">
        update cght.t_contract_template
        set col_order = #{col_order}
        where id = #{id}
    </update>
</mapper>
